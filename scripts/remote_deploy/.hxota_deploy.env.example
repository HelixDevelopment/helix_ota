# =============================================================================
# .hxota_deploy.env.example — TEMPLATE for the HelixOTA remote-deploy env.
# -----------------------------------------------------------------------------
# Copy to a GITIGNORED location and fill in REAL values (§11.4.10):
#   - ATMOSphere / consumer repo:  scripts/testing/secrets/.hxota_deploy.env  (chmod 600)
#   - or point HXOTA_DEPLOY_ENV=<path> at it explicitly.
# NEVER commit the filled-in file. This template carries ONLY placeholders.
# The deploy scripts source it (never echo a value) and redact host/port/user in
# all printed output by default (HXOTA_REDACT=1).
# =============================================================================

# ---- connection (SSH to the deploy host) ------------------------------------
ADDRESS_HXOTA=<server-host-or-ip>
ADDRESS_HXOTA_IPV6=<optional-ipv6>
SSH_PORT_HXOTA=<ssh-port>
HXOTA_DEPLOY_USER=hxota
HXOTA_DEPLOY_HOME=/home/hxota
# Deploy-user password — used ONLY when HXOTA_SSH_USE_PASSWORD=1 (passed via the
# SSHPASS env, never argv). PREFER SSH key auth (QD2) and leave this unused.
HXOTA_DEPLOY_PASSWORD=<deploy-user-password-OR-blank-if-key-auth>

# ---- root (bootstrap only — the deploy scripts do NOT use root) --------------
# Kept for the one-time host bootstrap (QD1 root-pw change). Never shipped to the
# remote stack.env; never used by the deploy pipeline.
HXOTA_ROOT_USER=root
HXOTA_ROOT_PASSWORD=<root-password>

# ---- SSH auth mode (QD2) -----------------------------------------------------
# 0 = SSH key auth (RECOMMENDED). 1 = password auth via sshpass (SSHPASS env).
HXOTA_SSH_USE_PASSWORD=0
# Optional private-key path for key auth:
#HXOTA_SSH_KEY=/home/you/.ssh/id_hxota_ed25519

# ---- runtime secrets (RUNTIME stack.env — QD6: where these live/generate) ---
# These are shipped to $HXOTA_REMOTE_DIR/stack.env (chmod 600) for the compose.
# The deploy pipeline FAILS CLOSED if a mandatory one is unset (never a weak/
# silent default, §11.4.6). Generate strong values, e.g.  openssl rand -base64 48
HXOTA_PG_USER=helix
HXOTA_PG_DB=helix_ota
HXOTA_PG_PASSWORD=<strong-random>
HXOTA_MINIO_USER=<minio-access-key>
HXOTA_MINIO_PASSWORD=<strong-random>
HXOTA_TOKEN_SECRET=<strong-random-48B-base64>
# Trusted ed25519 artifact public key (base64) — the build-pipeline signing key.
HXOTA_ARTIFACT_PUBKEY=<base64-ed25519-pubkey>
HXOTA_ARTIFACT_BASE_URL=https://hxota.dev/artifacts

# ---- ports (QD: 80/443 rootless requires the host sysctl, see REMOTE_DEPLOY.md)
HXOTA_HTTP_PORT=8080
HXOTA_HTTPS_PORT=8443
HXOTA_MAX_INFLIGHT=256

# ---- HTTPS / lets_encrypt submodule (QD: not yet incorporated) --------------
#LETS_ENCRYPT_HOME=/path/to/submodules/lets_encrypt
#HXOTA_LE_ENTRYPOINT=/path/to/submodules/lets_encrypt/lets_encrypt.sh   # UNCONFIRMED — confirm vs README
#HXOTA_LE_DOMAINS="hxota.dev hxota.com"
#HXOTA_LE_EMAIL=<acme-account-email>
#LE_RELOAD_CMD=<remote reload cmd after cert rotation>

# ---- SFTP artifact publishing (submodule — QD: not yet incorporated) --------
HXOTA_SFTP_REPO=git@github.com:vasic-digital/sftp.git
#HXOTA_SFTP_HOME=/path/to/submodules/sftp
#HXOTA_SFTP_ENTRYPOINT=/path/to/submodules/sftp/sftp_upload.sh          # UNCONFIRMED — confirm vs README
#HXOTA_ARTIFACT_DEST=/home/hxota/hxota-stack/srv/downloads

# ---- product family (Svord -> {atmosphere, mistiq_vader}) -------------------
HXOTA_PRODUCT=svord
HXOTA_PRODUCTS="atmosphere mistiq_vader"
