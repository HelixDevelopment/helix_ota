# deploy/svord/products/atmosphere.env.example — ATMOSphere product config (DATA).
# Copy to atmosphere.env. Non-secret product data injected when HXOTA_PRODUCT=atmosphere.
# The stack stays product-agnostic (§11.4.28); this only seeds ATMOSphere's OTA
# project/channels/target policy. NO credentials (§11.4.10).

HXOTA_IMAGE_TAG=atmosphere
# OTA target compatibility (ota-artifact-validator TargetPolicy).
HXOTA_TARGET_OS_TYPE=android
HXOTA_TARGET_BOARD=rk3588_t
# Device-group -> channel mapping seed (bench units on internal/canary).
HXOTA_SEED_GROUPS="atmosphere-field atmosphere-bench"
HXOTA_SEED_CHANNELS="stable canary internal"
