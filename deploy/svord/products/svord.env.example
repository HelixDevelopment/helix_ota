# deploy/svord/products/svord.env.example — Svord product-FAMILY defaults (DATA).
# Copy to svord.env (non-secret; may be committed) to seed the stack for the whole
# Svord line. The stack itself is product-AGNOSTIC (§11.4.28) — this file only
# injects channel/project seeding + the products the OTA control plane serves.
# NO credentials here (§11.4.10 — those live in the gitignored deploy env).

# Products this OTA control plane serves (multi-tenant projects + channels).
HXOTA_PRODUCTS="atmosphere mistiq_vader"

# Default image tag for this product-family deploy.
HXOTA_IMAGE_TAG=svord

# Release channels seeded per product post-deploy (stable/beta/canary/internal).
HXOTA_SEED_CHANNELS="stable beta canary internal"
