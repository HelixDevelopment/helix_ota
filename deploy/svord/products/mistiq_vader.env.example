# deploy/svord/products/mistiq_vader.env.example — Mistiq/VADER product config (DATA).
# Copy to mistiq_vader.env. Non-secret product data injected when
# HXOTA_PRODUCT=mistiq_vader. The stack stays product-agnostic (§11.4.28); this
# only seeds the Mistiq/VADER OTA project/channels/target policy. NO credentials.

HXOTA_IMAGE_TAG=mistiq_vader
# OTA target compatibility — fill in the real Mistiq/VADER board/OS once known
# (do NOT guess, §11.4.6 — leave as a documented TODO for the product owner).
HXOTA_TARGET_OS_TYPE=<mistiq-vader-os-type>
HXOTA_TARGET_BOARD=<mistiq-vader-board-id>
HXOTA_SEED_GROUPS="mistiq-field mistiq-bench"
HXOTA_SEED_CHANNELS="stable canary internal"
